{
  "Comment": "One scheduled cycle: seven commodity pipelines in parallel, then the portfolio stage, then the Telegram digest. Fixed run shape.",
  "StartAt": "Commodities",
  "States": {
    "Commodities": {
      "Type": "Pass",
      "Result": ["corn", "soybeans", "wheat", "sugar", "coffee", "cotton", "cocoa"],
      "ResultPath": "$.commodities",
      "Next": "RunCommodities"
    },
    "RunCommodities": {
      "Type": "Map",
      "ItemsPath": "$.commodities",
      "MaxConcurrency": 7,
      "ItemSelector": {
        "commodity.$": "$$.Map.Item.Value",
        "scheduled_time.$": "$.scheduled_time"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "Pipeline",
        "States": {
          "Pipeline": {
            "Type": "Task",
            "Resource": "${commodity_pipeline_arn}",
            "Retry": [
              { "ErrorEquals": ["LateStartError"], "MaxAttempts": 0 },
              {
                "ErrorEquals": ["States.ALL"],
                "IntervalSeconds": 10,
                "MaxAttempts": 2,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
            ],
            "End": true
          },
          "MarkFailed": {
            "Type": "Pass",
            "Parameters": { "commodity.$": "$.commodity", "failed": true, "call": null },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "Portfolio"
    },
    "Portfolio": {
      "Type": "Task",
      "Resource": "${portfolio_arn}",
      "Parameters": {
        "scheduled_time.$": "$.scheduled_time",
        "results.$": "$.results"
      },
      "Next": "Digest"
    },
    "Digest": {
      "Type": "Task",
      "Resource": "${digest_arn}",
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.digest_error", "Next": "DigestFailed" }
      ],
      "End": true
    },
    "DigestFailed": {
      "Type": "Pass",
      "Comment": "A failed notification must not fail a cycle whose books are already written; the digest Lambda's error alarm reports it.",
      "End": true
    }
  }
}
