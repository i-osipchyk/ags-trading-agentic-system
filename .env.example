# Copy to .env and fill in. .env is gitignored; this file is not.

# DeepSeek (OpenAI-compatible chat completions API) — all agents
DEEPSEEK_API_KEY=

# cTrader Open API — price/curve data, wrapped with crochet
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# Tavily — news analyst search
TAVILY_API_KEY=

# Hard cap on tool calls per agent per run (optional, default: 5)
MAX_TOOL_CALLS=
