# Copy to .env and fill in. .env is gitignored; this file is not.
# Deployed values live in SSM under /ags/<env>/<kebab-name> (scripts/put_secrets.py).

# llmkit attribution (on Lambda the lambda-app module sets these)
LLMKIT_PROJECT=ags
LLMKIT_ENV=local
# Optional: also send usage to Langfuse (shared keys; on AWS they're in /platform/shared/*)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# DeepSeek (OpenAI-compatible chat completions API) — all agents, called through llmkit.
# One key per project, so the DeepSeek console can cross-check llmkit's numbers.
DEEPSEEK_API_KEY=
# Optional overrides (default: https://api.deepseek.com / deepseek-chat) —
# swapping models or providers later is a config change, not a redesign. A model missing from
# llmkit's price table is recorded as unpriced (the digest counts those calls).
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# cTrader Open API — price/curve data, wrapped with crochet
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
# Seeds the token-refresh Lambda (put_secrets.py --include-tokens); it rotates both after that
CTRADER_REFRESH_TOKEN=

# Tavily — news analyst search
TAVILY_API_KEY=

# Hard cap on tool calls per agent per run (optional, default: 5)
MAX_TOOL_CALLS=

# Number of latest daily candles (with EMAs) the Technical analyst sees for
# its chart description (optional, default: 30)
CHART_LOOKBACK_CANDLES=

# Telegram — digest and pipeline alerts (AWS alarms go through the shared platform-alarms topic)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS region for boto3, scripts and local terraform (config.load_env() defaults it to eu-west-1)
AWS_REGION=eu-west-1
